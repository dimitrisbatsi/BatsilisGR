---
import Layout from '../layouts/Layout.astro';
import PostList from './PostList.astro';
import { POST_LOCALES, blogIndexPath, homePath, type Alternates, type PostLocale } from '../i18n/config';
import { getPublishedPosts } from '../i18n/content';
import { BLOG_UI, UI } from '../i18n/ui';

interface Props {
  locale: PostLocale;
}

const { locale } = Astro.props;
const t = BLOG_UI[locale];
const posts = await getPublishedPosts(locale);
const alternates: Alternates = Object.fromEntries(POST_LOCALES.map((l) => [l, blogIndexPath(l)]));
---

<Layout locale={locale} alternates={alternates} title={t.metaTitle} description={t.metaDescription}>
  <section class="max-w-2xl mx-auto px-6 py-12 md:py-24 space-y-8 font-sans">
    <nav>
      <a
        href={homePath(locale)}
        class="inline-flex items-center gap-2 text-xs font-mono uppercase text-zinc-500 hover:text-brand-accent transition-colors duration-200 group"
      >
        <span class="group-hover:-translate-x-1 transition-transform duration-200">&larr;</span>
        {UI[locale].backToPortfolio}
      </a>
    </nav>

    <header class="space-y-4">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-white leading-tight">{t.heading}</h1>
      <p class="text-zinc-400 text-base leading-relaxed font-light">{t.intro}</p>
    </header>

    <hr class="border-zinc-800/80" />

    <PostList locale={locale} posts={posts} headingLevel="h2" />
  </section>
</Layout>
