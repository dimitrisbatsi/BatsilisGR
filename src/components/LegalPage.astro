---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { LOCALES, LOCALE_META, homePath, legalPath, type Alternates, type Locale } from '../i18n/config';
import { getLocalizedCollection } from '../i18n/content';
import { UI } from '../i18n/ui';
import { documentTitle } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];

const entry = (await getLocalizedCollection('legal', locale)).find((item) => item.slug === 'notice')?.entry;
if (!entry) {
  throw new Error(`Missing legal notice: add src/content/legal/${locale}/notice.md.`);
}
const { Content } = await render(entry);

const alternates: Alternates = Object.fromEntries(LOCALES.map((l) => [l, legalPath(l)]));
const updated = entry.data.updatedDate;
const formattedUpdated = updated.toLocaleDateString(LOCALE_META[locale].dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout locale={locale} alternates={alternates} title={documentTitle(entry.data.title)} description={entry.data.description}>
  <article class="max-w-2xl mx-auto px-6 py-12 md:py-24 space-y-8 font-sans">
    <nav>
      <a
        href={homePath(locale)}
        class="inline-flex items-center gap-2 text-xs font-mono uppercase text-zinc-500 hover:text-brand-accent transition-colors duration-200 group"
      >
        <span class="group-hover:-translate-x-1 transition-transform duration-200">&larr;</span>
        {t.backToPortfolio}
      </a>
    </nav>

    <header class="space-y-4">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-white leading-tight">{entry.data.title}</h1>
      <time datetime={updated.toISOString()} class="block text-xs font-mono text-zinc-500">{formattedUpdated}</time>
    </header>

    <hr class="border-zinc-800/80" />

    <div class="text-zinc-300 leading-relaxed prose-custom">
      <Content />
    </div>
  </article>
</Layout>
