---
// Interactive cursor with floating "Click Me" tag & neon orange glass fracture effect on click
---

<div id="interactive-cursor-badge" class="hidden md:block fixed pointer-events-none z-50 transition-opacity duration-200 opacity-0 text-[10px] font-mono font-medium tracking-wide uppercase px-2 py-0.5 rounded-full bg-[#111827]/90 text-[#FF9030] border border-[#FF9030]/40 backdrop-blur-md shadow-[0_0_12px_rgba(255,144,48,0.25)] select-none will-change-transform">
  Click Me
</div>

<div id="glass-crack-container" class="pointer-events-none fixed inset-0 z-40 overflow-hidden"></div>

<script>
  function setupInteractiveCursor() {
    // Only enable on desktop pointer devices
    if (!window.matchMedia('(pointer: fine)').matches) return;

    const badge = document.getElementById('interactive-cursor-badge');
    const container = document.getElementById('glass-crack-container');
    if (!badge || !container) return;

    let mouseX = -100;
    let mouseY = -100;
    let currentX = -100;
    let currentY = -100;
    let isVisible = false;
    let rafId: number | null = null;

    // Smooth cursor follower animation
    function updateCursorPosition() {
      // Linear interpolation for smooth trailing
      currentX += (mouseX - currentX) * 0.35;
      currentY += (mouseY - currentY) * 0.35;

      badge.style.transform = `translate3d(${currentX + 14}px, ${currentY - 14}px, 0)`;

      rafId = requestAnimationFrame(updateCursorPosition);
    }

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!isVisible) {
        isVisible = true;
        badge.style.opacity = '1';
        if (!rafId) {
          currentX = mouseX;
          currentY = mouseY;
          rafId = requestAnimationFrame(updateCursorPosition);
        }
      }
    });

    document.addEventListener('mouseleave', () => {
      isVisible = false;
      badge.style.opacity = '0';
    });

    // Handle interactive hover states (links, buttons)
    document.addEventListener('mouseover', (e) => {
      const target = e.target as HTMLElement;
      if (target && target.closest('a, button, [role="button"], input, textarea')) {
        badge.textContent = 'Explore';
        badge.style.borderColor = 'rgba(255, 144, 48, 0.8)';
        badge.style.boxShadow = '0 0 16px rgba(255, 144, 48, 0.45)';
      } else {
        badge.textContent = 'Click Me';
        badge.style.borderColor = 'rgba(255, 144, 48, 0.4)';
        badge.style.boxShadow = '0 0 12px rgba(255, 144, 48, 0.25)';
      }
    });

    // Glass fracture effect on click
    document.addEventListener('click', (e) => {
      const clickX = e.clientX;
      const clickY = e.clientY;

      createCrack(clickX, clickY);
    });

    function createCrack(x: number, y: number) {
      const crack = document.createElement('div');
      crack.className = 'absolute pointer-events-none will-change-transform';
      crack.style.left = `${x}px`;
      crack.style.top = `${y}px`;
      crack.style.transform = 'translate(-50%, -50%)';
      crack.style.transition = 'opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1)';
      crack.style.opacity = '1';

      // Procedurally generate geometric glass fracture paths
      const size = 120;
      const center = size / 2;
      const numRays = 6 + Math.floor(Math.random() * 3); // 6-8 main fracture lines
      let pathLines = '';

      for (let i = 0; i < numRays; i++) {
        const baseAngle = (i * (2 * Math.PI / numRays)) + (Math.random() * 0.4 - 0.2);
        const length = 28 + Math.random() * 26; // ray length
        
        // Jagged line with 2 mid segments
        const mid1Len = length * 0.4;
        const mid1Angle = baseAngle + (Math.random() * 0.3 - 0.15);
        const x1 = center + Math.cos(mid1Angle) * mid1Len;
        const y1 = center + Math.sin(mid1Angle) * mid1Len;

        const mid2Len = length * 0.75;
        const mid2Angle = baseAngle + (Math.random() * 0.35 - 0.17);
        const x2 = center + Math.cos(mid2Angle) * mid2Len;
        const y2 = center + Math.sin(mid2Angle) * mid2Len;

        const endX = center + Math.cos(baseAngle) * length;
        const endY = center + Math.sin(baseAngle) * length;

        pathLines += `<path d="M ${center} ${center} L ${x1.toFixed(1)} ${y1.toFixed(1)} L ${x2.toFixed(1)} ${y2.toFixed(1)} L ${endX.toFixed(1)} ${endY.toFixed(1)}" stroke="#FF9030" stroke-width="${(1 + Math.random() * 0.7).toFixed(1)}" stroke-linecap="round" fill="none" opacity="${(0.75 + Math.random() * 0.25).toFixed(2)}" />`;

        // Add small secondary branching fissure
        if (Math.random() > 0.35) {
          const branchAngle = mid1Angle + (Math.random() > 0.5 ? 0.6 : -0.6);
          const branchLen = 12 + Math.random() * 14;
          const bx = x1 + Math.cos(branchAngle) * branchLen;
          const by = y1 + Math.sin(branchAngle) * branchLen;
          pathLines += `<path d="M ${x1.toFixed(1)} ${y1.toFixed(1)} L ${bx.toFixed(1)} ${by.toFixed(1)}" stroke="#FF9030" stroke-width="0.8" stroke-linecap="round" fill="none" opacity="0.6" />`;
        }
      }

      crack.innerHTML = `
        <svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}" class="overflow-visible drop-shadow-[0_0_8px_rgba(255,144,48,0.7)]">
          ${pathLines}
        </svg>
      `;

      container.appendChild(crack);

      // Start fade out after 2.2 seconds
      setTimeout(() => {
        crack.style.opacity = '0';
        crack.style.transform = 'translate(-50%, -50%) scale(1.08)';
      }, 2200);

      // Remove from DOM after transition completes (3s total)
      setTimeout(() => {
        crack.remove();
      }, 3000);
    }
  }

  // Initialize on page load and support view transitions / hot-reloads
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupInteractiveCursor);
  } else {
    setupInteractiveCursor();
  }
  document.addEventListener('astro:page-load', setupInteractiveCursor);
</script>
