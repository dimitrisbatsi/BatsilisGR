---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { AUTHOR, DEFAULT_OG_IMAGE, SITE_URL, personSchema } from '../lib/seo';
import { LOCALE_META, homePath, postPath, type Alternates, type Locale } from '../i18n/config';
import { getPostLocales } from '../i18n/content';
import { UI } from '../i18n/ui';

interface Props {
  locale: Locale;
  slug: string;
  post: CollectionEntry<'posts'>;
}

const { locale, slug, post } = Astro.props;
const t = UI[locale];
const { Content } = await render(post);

const alternates: Alternates = Object.fromEntries(
  (await getPostLocales(slug)).map((l) => [l, postPath(l, slug)]),
);

const site = Astro.site ?? new URL(SITE_URL);
const postURL = new URL(postPath(locale, slug), site).href;
const author = personSchema(site);
const blogPosting = {
  '@type': 'BlogPosting',
  '@id': `${postURL}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  url: postURL,
  mainEntityOfPage: postURL,
  image: new URL(DEFAULT_OG_IMAGE.src, site).href,
  inLanguage: LOCALE_META[locale].htmlLang,
  author: { '@id': author['@id'] },
  publisher: { '@id': author['@id'] },
};

const formattedDate = post.data.pubDate.toLocaleDateString(LOCALE_META[locale].dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  locale={locale}
  alternates={alternates}
  title={`${post.data.title} | ${AUTHOR.name}`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  jsonLd={[blogPosting, author]}
>
  <article class="max-w-2xl mx-auto px-6 py-12 md:py-24 space-y-8 font-sans">

    <!-- Monospace Navigation back link -->
    <nav>
      <a
        href={homePath(locale)}
        class="inline-flex items-center gap-2 text-xs font-mono uppercase text-zinc-500 hover:text-brand-accent transition-colors duration-200 group"
      >
        <span class="group-hover:-translate-x-1 transition-transform duration-200">&larr;</span>
        {t.backToPortfolio}
      </a>
    </nav>

    <!-- Article Header Info -->
    <header class="space-y-4">
      <div class="flex items-center gap-4 text-xs font-mono text-zinc-500">
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        <span class="text-zinc-700">&middot;</span>
        <span class="text-brand-accent">{post.data.readingTime}</span>
      </div>

      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-white leading-tight">
        {post.data.title}
      </h1>

      <p class="text-zinc-400 text-base leading-relaxed font-light">
        {post.data.description}
      </p>
    </header>

    <hr class="border-zinc-800/80" />

    <!-- Article Markdown Content Body -->
    <div class="text-zinc-300 leading-relaxed prose-custom">
      <Content />
    </div>

  </article>
</Layout>
