---
import "../styles/global.css";
// Self-hosted fonts: Vite bundles the files under /_astro/, so no visitor IP reaches a third-party font CDN (GDPR).
// Each weight file covers every subset via unicode-range; browsers fetch only the subsets a page uses.
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/geist-mono/300.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "@fontsource/geist-mono/600.css";
import "@fontsource/geist-mono/700.css";
// JetBrains Mono supplies the Greek glyphs that Geist Mono lacks
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/600.css";
import Analytics from "@vercel/analytics/astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import {
  AUTHOR,
  DEFAULT_OG_IMAGE,
  SITE_URL,
  personSchema,
  serializeJsonLd,
  type JsonLd,
  type OgImage,
} from "../lib/seo";
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, X_DEFAULT_LOCALE, legalPath, postLocaleFor, rssPath, type Alternates, type Locale } from "../i18n/config";
import { BLOG_UI, UI } from "../i18n/ui";

interface Props {
  locale: Locale;
  /** Site-relative paths of this page in every language it exists in, including the current one. */
  alternates?: Alternates;
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  image?: OgImage;
  jsonLd?: JsonLd[];
  noindex?: boolean;
}

const site = Astro.site ?? new URL(SITE_URL);

const { locale, alternates = {}, type = "website", publishedTime, modifiedTime, jsonLd = [personSchema(site)], noindex = false } =
  Astro.props;
const t = UI[locale];
const meta = LOCALE_META[locale];
const feedLocale = postLocaleFor(locale);
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const image = Astro.props.image ?? { ...DEFAULT_OG_IMAGE, alt: t.meta.ogImageAlt };

const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = new URL(image.src, site);

const hreflangLinks = LOCALES.flatMap((l) => {
  const path = alternates[l];
  return path ? [{ hreflang: LOCALE_META[l].htmlLang, href: new URL(path, site).href }] : [];
});
const xDefault = alternates[X_DEFAULT_LOCALE] ?? alternates[DEFAULT_LOCALE];
const otherOgLocales = LOCALES.filter((l) => l !== locale && alternates[l]).map((l) => LOCALE_META[l].ogLocale);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.name} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <!-- Language Alternates -->
    {!noindex && hreflangLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    {!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, site).href} />}

    <link rel="alternate" type="application/rss+xml" title={BLOG_UI[feedLocale].rssTitle} href={new URL(rssPath(feedLocale), site)} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={AUTHOR.name} />
    <meta property="og:locale" content={meta.ogLocale} />
    {otherOgLocales.map((ogLocale) => <meta property="og:locale:alternate" content={ogLocale} />)}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {type === "article" && <meta property="article:author" content={new URL("/", site).href} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={image.alt} />

    <!-- Structured Data -->
    {jsonLd.length > 0 && <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    class="relative bg-bg-primary text-zinc-300 selection:bg-zinc-800 selection:text-zinc-50 min-h-screen antialiased flex flex-col justify-between"
  >
    <!-- Thin structural border at the top of the viewport with brand glow -->
    <div class="h-1 bg-brand-accent w-full shadow-[0_1px_12px_rgba(255,144,48,0.4)]"></div>

    <LanguageSwitcher locale={locale} alternates={alternates} />

    <main class="flex-grow">
      <slot />
    </main>

    <!-- Simple, premium minimalist footer -->
    <footer
      class="border-t border-border-primary py-8 text-center text-xs font-mono text-zinc-500 max-w-5xl mx-auto w-full px-6 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <div class="flex flex-col items-center md:items-start gap-2">
        <span>&copy; {new Date().getFullYear()} {AUTHOR.name}. {t.footer.rights}</span>
        <a href={legalPath(locale)} class="hover:text-brand-accent transition-colors duration-200">{t.footer.legal}</a>
      </div>
      <div class="flex flex-col md:flex-row items-center gap-2 md:gap-4">
        <span>{t.footer.location}</span>
        <span class="hidden md:inline text-zinc-700">|</span>
        <span>{t.footer.builtWith}</span>
      </div>
    </footer>

    <Analytics />
  </body>
</html>
