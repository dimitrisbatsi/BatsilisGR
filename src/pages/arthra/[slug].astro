---
import BlogPost from '../../components/BlogPost.astro';
import { getPublishedPosts } from '../../i18n/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('el');
  return posts.map(({ entry, slug }) => ({ params: { slug }, props: { post: entry, slug } }));
}

const { post, slug } = Astro.props;
---

<BlogPost locale="el" slug={slug} post={post} />
