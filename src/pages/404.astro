---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Page Not Found | Dimitrios P. Batsilis"
  description="The requested page does not exist."
  jsonLd={[]}
  noindex
>
  <section class="max-w-2xl mx-auto px-6 py-24 md:py-40 space-y-6 font-sans">
    <div class="text-xs font-mono text-brand-accent tracking-widest">ERROR 404 // ROUTE NOT RESOLVED</div>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-white">This page does not exist.</h1>
    <p class="text-zinc-400 text-base leading-relaxed">
      The link may be outdated or the address mistyped. Everything published lives on the portfolio index.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-brand-accent/10 hover:bg-brand-accent/20 border border-brand-accent/30 hover:border-brand-accent/60 text-brand-accent hover:text-white text-xs font-mono font-medium transition-all duration-200 group"
    >
      <span class="group-hover:-translate-x-1 transition-transform duration-200">&larr;</span>
      BACK TO PORTFOLIO
    </a>
  </section>
</Layout>
